{
  "name": "rp-hub-magic",
  "private": true,
  "type": "module",
  "description": "RP Hub 魔改版根工作区：ESLint 死代码门禁（npm run lint）",
  "scripts": {
    "lint": "eslint .",
    "test": "npm --prefix .sync-tests test && npm run test:deployer-flow && npm run test:deployer-blake3",
    "test:scale": "node --max-old-space-size=8192 --expose-gc .sync-tests/scale-sim.mjs",
    "build:page-zip": "node deployer/make-page-zip.mjs",
    "test:deployer-flow": "node deployer/test-flow.mjs",
    "test:deployer-blake3": "node deployer/test-blake3.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "eslint": "^10.11.0"
  }
}
